/* app.wxss 全局样式 - 绿色主题 + 大卡片布局 */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 大卡片基础样式（全局通用） */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 32rpx;
  margin: 0 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

/* 首页壁纸卡片特殊处理 */
.card-wallpaper {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  padding: 0;
  margin: 24rpx 24rpx 24rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-wallpaper .bg-img {
  width: 100%;
  height: 100%;
}

.card-wallpaper .quote-text {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}
