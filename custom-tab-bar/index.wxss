/* custom-tab-bar/index.wxss - 底部导航（字体放大版） */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.tab-text {
  font-size: 30rpx;
  color: #999999;
  margin-top: 6rpx;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #07c160;
  font-weight: 700;
}
