/* components/news-card/index.wxss - 卡片：左文右图，无图时文字自动占满 */
.news-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin: 0 24rpx 20rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  min-height: 180rpx;
}

.news-card-hover {
  background: #f7f7f7;
}

.rank-badge {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-right: 16rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #999999;
  background: #f2f2f2;
}

.rank-top {
  color: #ffffff;
  background: #fa5151;
}

.card-change {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  font-size: 20rpx;
  line-height: 1.4;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.change-up {
  color: #fa5151;
  background: rgba(250, 81, 81, 0.1);
}

.change-down {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.change-new {
  color: #576b95;
  background: rgba(87, 107, 149, 0.1);
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #222222;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.card-tag {
  font-size: 22rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.card-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #888888;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #aaaaaa;
}

.meta-source {
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-dot {
  margin: 0 8rpx;
}

.meta-time {
  flex: none;
}

.meta-hot {
  margin-left: 12rpx;
  color: #fa5151;
}

.card-cover {
  flex: none;
  width: 200rpx;
  height: 140rpx;
  margin-left: 20rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}
