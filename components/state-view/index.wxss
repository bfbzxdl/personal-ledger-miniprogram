/* components/state-view/index.wxss - 空态/错误态统一样式 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.state-text {
  font-size: 30rpx;
  line-height: 1.5;
  color: #666666;
  text-align: center;
}

.state-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaaaaa;
  text-align: center;
}

.state-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 999rpx;
}

.state-btn-hover {
  opacity: 0.7;
}

.state-btn-plain {
  margin-top: 16rpx;
  color: #999999;
  border-color: #dddddd;
}
