/* pages/home/home.wxss */
.page {
  padding-top: 8rpx;
  padding-bottom: 140rpx;
}

.guide-card {
  display: flex;
  flex-direction: column;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.guide-text {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 28rpx;
}

.guide-tabs {
  display: flex;
  justify-content: space-around;
}

.guide-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.guide-name {
  font-size: 26rpx;
  color: #666666;
}
