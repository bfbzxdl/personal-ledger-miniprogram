/* pages/work/index/index.wxss */
.page {
  padding: 24rpx 0 140rpx;
}

.now-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-label {
  font-size: 30rpx;
  color: #333333;
}

.field-value {
  font-size: 30rpx;
  color: #07c160;
}

.calc-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f7fbf8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}

.calc-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.calc-actual {
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1.8;
}

.submit-btn {
  margin-top: 28rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn::after {
  border: none;
}

.summary-card {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.calendar-card {
  padding: 16rpx;
}
