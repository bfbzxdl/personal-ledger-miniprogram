/* pages/ledger/index/index.wxss */
.page {
  padding: 24rpx 0 140rpx;
}

/* 月份 + 统计 */
.month-card {
  display: flex;
  flex-direction: column;
}

.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 24rpx;
}

.month-arrow {
  font-size: 48rpx;
  color: #07c160;
  padding: 0 24rpx;
  font-weight: 700;
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.summary-row {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0 8rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
}

.summary-value.income { color: #07c160; }
.summary-value.expense { color: #e64340; }
.summary-value.balance { color: #333333; }

/* 记一笔 */
.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
}

.type-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
}

.type-tab.active {
  background: #ffffff;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.type-tab.active.expense { color: #e64340; }
.type-tab.active.income { color: #07c160; }

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-label {
  font-size: 30rpx;
  color: #333333;
}

.field-input {
  font-size: 30rpx;
  color: #333333;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.field-value {
  font-size: 30rpx;
  color: #07c160;
}

.submit-btn {
  margin-top: 28rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn::after {
  border: none;
}

/* 流水列表 */
.list-card {
  padding-bottom: 40rpx;
}

.group-label {
  font-size: 24rpx;
  color: #999999;
  padding: 16rpx 8rpx 12rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-left {
  display: flex;
  align-items: center;
}

.record-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-title-row {
  display: flex;
  align-items: center;
}

.record-category {
  font-size: 30rpx;
  color: #333333;
}

.record-note-icon {
  font-size: 20rpx;
  margin-left: 12rpx;
  padding: 2rpx 6rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  line-height: 1.2;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.record-amount.income { color: #07c160; }
.record-amount.expense { color: #e64340; }

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
