/* pages/news/home/index.wxss - 热点页布局 */
.news-page {
  padding-top: 16rpx;
  padding-bottom: 40rpx;
}

/* 分段 */
.segment-bar {
  display: flex;
  margin: 0 24rpx 16rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

.segment {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
}

.segment-active {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-weight: 700;
}

/* 日期条 */
.day-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 24rpx 16rpx 24rpx;
  padding: 0 4rpx;
}

.day-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 600;
}

.day-more {
  font-size: 24rpx;
  color: #07c160;
}

/* 分类 */
.cat-bar {
  display: flex;
  align-items: center;
  white-space: nowrap;
  margin: 0 24rpx 16rpx 24rpx;
}

.cat {
  display: inline-block;
  flex: none;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #555555;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid #eeeeee;
}

.cat-active {
  color: #ffffff;
  background: #07c160;
  border-color: #07c160;
  font-weight: 600;
}

/* 标签筛选 */
.tag-bar {
  display: flex;
  white-space: nowrap;
  margin: 0 24rpx 16rpx 24rpx;
}

.tag-chip {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 8rpx;
}

.tag-chip-active {
  color: #ffffff;
  background: #07c160;
}

/* 列表头/尾 */
.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 4rpx 32rpx 12rpx 32rpx;
  font-size: 22rpx;
  color: #aaaaaa;
}

.list-total {
  color: #888888;
}

.list-updated {
  color: #bbbbbb;
}

.list-footer {
  text-align: center;
  font-size: 24rpx;
  color: #bbbbbb;
  padding: 20rpx 0 40rpx 0;
}

/* 热榜 */
.hot-head {
  display: flex;
  flex-direction: column;
  margin: 8rpx 32rpx 20rpx 32rpx;
}

.hot-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222222;
}

.hot-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #aaaaaa;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #bbbbbb;
  font-size: 26rpx;
}

.search-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #07c160;
  border-radius: 999rpx;
}

.range-bar {
  display: flex;
  margin: 0 24rpx 20rpx 24rpx;
}

.range-chip {
  padding: 8rpx 24rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #666666;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  border-radius: 999rpx;
}

.range-active {
  color: #07c160;
  border-color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  font-weight: 600;
}

/* 搜索历史 */
.history {
  margin: 8rpx 24rpx 0 24rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 26rpx;
  color: #666666;
  font-weight: 600;
}

.history-clear {
  font-size: 24rpx;
  color: #999999;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
}

.history-chip {
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 24rpx;
  color: #555555;
  background: #ffffff;
  border-radius: 999rpx;
}

/* 昨日数据兜底提示 */
.notice-bar {
  margin: 0 24rpx 16rpx 24rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  background: #fff8e1;
  border-radius: 10rpx;
}

/* 骨架屏 */
.skeleton {
  padding-top: 4rpx;
}

.sk-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sk-line {
  background: #f0f0f0;
  border-radius: 8rpx;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.sk-title {
  width: 92%;
  height: 34rpx;
}

.sk-sub {
  width: 68%;
}

.sk-meta {
  width: 36%;
  height: 22rpx;
  margin-bottom: 0;
}

/* 空态/错误态 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.state-text {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
}

.state-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaaaaa;
}

.state-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 999rpx;
}

.state-btn-plain {
  margin-top: 16rpx;
  color: #999999;
  border-color: #dddddd;
}

